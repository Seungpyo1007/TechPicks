# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.migrate_working_dir/
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Android-specific files
android/app/google-services.json
android/local.properties

# ios-specific files
ios/Runner/GoogleService-Info.plist

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
android/app/build/
android/build/
android/.gradle/

# 골든이 어긋나면 flutter test 가 여기에 비교 이미지를 쏟는다.
test/golden/failures/

# 명세·인계·디자인 시안. 로컬에만 둔다.
docs/

# Xcode 가 프로젝트를 열 때마다 써넣는 개인 설정. 스킴을 접었는지 펼쳤는지
# 같은 것이라 공유할 내용이 없는데, third_party/native_liquid_glass 안에
# 들어 있어서 열 때마다 작업 트리가 더러워졌다.
**/xcuserdata/
**/*.xcuserstate

# Flutter 가 빌드마다 다시 쓰는 플러그인 목록. 기기마다 경로가 달라 늘 바뀐다.
.flutter-plugins
.flutter-plugins-dependencies

# 테스트 커버리지 결과물.
coverage/

# Firebase Hosting 배포 캐시.
.firebase/

# 로컬 에이전트 설정·워크트리.
.claude/
