**/ios/Flutter/.last_build_id
.dart_tool/
.pub-cache/
.pub/
/build/
.flutter-plugins
.flutter-plugins-dependencies

# Local Xcode user state.
**/xcuserdata/
**/*.xcuserstate

# Symbolication related
app.*.symbols

